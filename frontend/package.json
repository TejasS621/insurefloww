{
  "name": "insurefloww-frontend-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "user-frontend",
    "user-admin-frontend",
    "provider-admin-frontend"
  ],
  "scripts": {
    "dev:user": "npm --prefix ./user-frontend run dev",
    "dev:user-admin": "npm --prefix ./user-admin-frontend run dev",
    "dev:provider-admin": "npm --prefix ./provider-admin-frontend run dev",
    "build:user": "npm --prefix ./user-frontend run build",
    "build:user-admin": "npm --prefix ./user-admin-frontend run build",
    "build:provider-admin": "npm --prefix ./provider-admin-frontend run build"
  }
}
