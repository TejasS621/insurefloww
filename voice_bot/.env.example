# Voice bot provider keys
GROQ_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Voice bot tuning
VOICE_BOT_APP_NAME=InsureFlow Voice Bot
VOICE_BOT_LOG_LEVEL=INFO
VOICE_BOT_GROQ_MODEL=llama-3.3-70b-versatile
VOICE_BOT_CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121
