# Reused MCP and backend settings
MAIN_BACKEND_URL=http://127.0.0.1:8000/api/v1
MCP_REQUEST_TIMEOUT_SECONDS=15
MCP_MAX_RETRIES=2
MCP_RETRY_BACKOFF_SECONDS=0.5
MCP_DOWNLOAD_DIRECTORY=storage/mcp_downloads
